    "# Разделяем данные на положительные и отрицательные изменения\n",
    "positive_changes = combined_table[combined_table['Изменение средней выручки (%)'] > 0].sort_values(by='Изменение средней выручки (%)', ascending=False)\n",
    "negative_changes = combined_table[combined_table['Изменение средней выручки (%)'] <= 0].sort_values(by='Изменение средней выручки (%)', ascending=False)\n",
