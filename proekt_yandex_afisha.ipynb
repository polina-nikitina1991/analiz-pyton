    "# Группируем данные по типу мероприятия и сезону, вычисляем среднее значение выручки с билета\n",
    "mean_revenue = df.groupby(['event_type_main', 'season'])['one_ticket_revenue_rub'].mean().unstack()\n",
    "\n",
    "revenue_change = ((mean_revenue['Осень'] / mean_revenue['Лето']) - 1) * 100\n",
    "revenue_change.name = 'Изменение средней выручки (%)'\n",
    "\n",
    "# Объединяем все данные в одну таблицу\n",
    "combined_table = pd.concat([mean_revenue, revenue_change], axis=1)\n",
    "combined_table.sort_values(by='Изменение средней выручки (%)', ascending=False, inplace=True)\n",
    "\n",
    "display(combined_table)\n",
    "\n",
    "plt.figure(figsize=(12, 6))\n",
    "plt.plot(combined_table.index, combined_table['Изменение средней выручки (%)'], marker='o')\n",
