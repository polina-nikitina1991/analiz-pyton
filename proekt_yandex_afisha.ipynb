    "\n",
    "# Фильтруем данные за осенний сезон и преобразуем дату\n",
    "df_fall = df[df['season'] == 'Осень'].copy()\n",
    "df_fall['date'] = pd.to_datetime(df_fall['created_dt_msk'])\n",
    "\n",
    "# Группируем данные по дате и вычисляем необходимые показатели\n",
    "daily_stats = df_fall.groupby('date').agg(\n",
    "    total_orders=('order_id', 'count'),\n",
    "    unique_users=('user_id', 'nunique'),\n",
    "    total_revenue=('one_ticket_revenue_rub', 'sum')\n",
    ").reset_index()\n",
    "\n",
    "# Вычисляем среднее число заказов на одного пользователя и округляем до 2 знаков\n",
    "daily_stats['avg_orders_per_user'] = (daily_stats['total_orders'] / daily_stats['unique_users']).round(2)\n",
    "\n",
    "# Вычисляем среднюю стоимость одного билета и округляем до 2 знаков\n",
    "daily_stats['avg_ticket_cost'] = (daily_stats['total_revenue'] / daily_stats['total_orders']).round(2)\n",
    "\n",
    "display(daily_stats[['date', 'total_orders', 'unique_users', 'avg_orders_per_user', 'avg_ticket_cost']])\n",
    "\n",
    "# График общего числа заказов\n",
    "plt.figure(figsize=(12, 4))\n",
    "plt.plot(daily_stats['date'], daily_stats['total_orders'], color='black', marker='o')\n",
    "plt.title('Динамика общего числа заказов ')\n",
    "plt.xlabel('Дата')\n",
    "plt.ylabel('Количество заказов')\n",
