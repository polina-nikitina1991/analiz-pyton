   "source": [
    "df = df.merge(\n",
    "    df_tenge[['data', 'curs']],\n",
    "    left_on=df['created_dt_msk'],\n",
    "    right_on=df_tenge['data'],\n",
    "    how='left'\n",
    ")\n",
    "df['revenue_rub'] = np.where(\n",
    "     df['currency_code'] == 'kzt',\n",
    "     df['revenue'] * (df['curs'] / 100),\n",
    "     df['revenue'])\n",
    "df['one_ticket_revenue_rub'] = df['revenue_rub'] / df['tickets_count']\n",
    "df['month'] = df['created_dt_msk'].dt.month\n",
    "def season(month):\n",
    "    if month in [12, 1, 2]:\n",
    "        return 'Зима'\n",
    "    elif month in [3, 4, 5]:\n",
    "        return 'Весна'\n",
    "    elif month in [6, 7, 8]:\n",
    "        return 'Лето'\n",
    "    else:\n",
    "        return 'Осень'\n",
    "\n",
    "df['season'] = df['month'].apply(season)\n",
    "df.head()"
   ]
  },
