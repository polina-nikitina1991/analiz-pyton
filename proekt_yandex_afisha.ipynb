   "source": [
    "# добавим столбец с днями недели\n",
    "df['day_of_week'] = df['created_dt_msk'].dt.dayofweek + 1\n",
    "\n",
    "# Группировка данных и агрегация\n",
    "df_day = df.groupby(['day_of_week']).agg(\n",
    "    total_orders=('order_id', 'count'),\n",
    "    unique_users=('user_id', 'nunique'),\n",
    "    total_revenue=('revenue_rub', 'sum')\n",
    ").reset_index()\n",
    "\n",
    "# Вычисление средних значений и округление до 2 знаков\n",
    "df_day['avg_orders_per_user'] = (df_day['total_orders'] / df_day['unique_users']).round(2)\n",
    "df_day['avg_revenue_per_user'] = (df_day['total_revenue'] / df_day['unique_users']).round(2)\n",
    "\n",
    "# Установление порядка дней недели\n",
    "weekday_order = ['Понедельник', 'Вторник', 'Среда', 'Четверг', 'Пятница', 'Суббота', 'Воскресенье']\n",
    "df_day['day_name'] = pd.Categorical(df_day['day_of_week'].map({1: 'Понедельник', 2: 'Вторник', 3: 'Среда', 4: 'Четверг', 5: 'Пятница', 6: 'Суббота', 7: 'Воскресенье'}), categories=weekday_order, ordered=True)\n",
    "df_day = df_day.sort_values('day_name')\n",
    "\n",
    "display(df_day)\n",
    "\n"
   ]
