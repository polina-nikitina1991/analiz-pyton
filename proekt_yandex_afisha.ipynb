    "# Подсчитываем уникальное количество мероприятий и общее число заказов по каждому региону\n",
    "region_stats = df.groupby('region_name').agg(\n",
    "    unique_events=('event_id', 'nunique'),\n",
    "    total_orders=('order_id', 'count'),\n",
