    "def count_unique_values(dataframe, columns):\n",
    "    result_tables = []\n",
    "    for column in columns:\n",
    "        value_counts = dataframe[column].value_counts()\n",
    "        result_table = pd.DataFrame({column: value_counts.index, f'count_{column}': value_counts.values})\n",
    "        result_tables.append(result_table)\n",
    "    \n",
    "    result = result_tables[0]\n",
    "    for table in result_tables[1:]:\n",
    "        result = pd.merge(result, table, how='outer', left_index=True, right_index=True)\n",
    "    return result\n",
    "\n",
    "# Список столбцов для анализа\n",
    "columns_to_analyze = ['cinema_circuit', 'age_limit', 'currency_code', 'device_type_canonical', 'event_type_main']\n",
    "\n",
    "result_table = count_unique_values(df, columns_to_analyze)\n",
    "\n",
    "display(result_table)\n"
   ]
